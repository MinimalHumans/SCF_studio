{
  "name": "@minimalhumans/scf-mcp",
  "version": "0.1.0",
  "description": "MCP server over a .scf file (docs/scf-mcp-design.md). Local stdio process; no hosting.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MinimalHumans/SCF_studio.git",
    "directory": "scf-mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "scf-mcp": "./dist/server.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepack": "node ../tools/legal_files.mjs copy && npm run build",
    "postpack": "node ../tools/legal_files.mjs remove",
    "pack:release": "node ../tools/pack_with_ranges.mjs pack",
    "publish:release": "node ../tools/pack_with_ranges.mjs publish",
    "prepublishOnly": "node ../tools/pack_with_ranges.mjs check"
  },
  "dependencies": {
    "@minimalhumans/scf-core": "file:../scf-core",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
