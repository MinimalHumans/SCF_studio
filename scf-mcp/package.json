{
  "name": "@minimalhumans/scf-mcp",
  "version": "0.1.0",
  "description": "MCP server over a .scf file (spec/scf-mcp-design.md). Local stdio process; no hosting.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "scf-mcp": "./dist/server.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@minimalhumans/scf-core": "file:../scf-core",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22.0.0"
  }
}
