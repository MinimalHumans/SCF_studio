{
  "name": "@minimalhumans/scf-core",
  "version": "0.1.0",
  "description": "SCF (Story Context Framework) core: registry types, database layer, and resolution/readiness semantics. UI-free.",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./registry.json": "./registry/registry.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "prepack": "npm run clean && npm run build",
    "pack-test": "node --experimental-strip-types scripts/pack_test.mjs",
    "emit-api-surface": "node --experimental-strip-types scripts/emit_api_surface.mjs",
    "check-api-surface": "node --experimental-strip-types scripts/emit_api_surface.mjs --check",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "conformance": "vitest run test/conformance.canonical.test.ts test/conformance.readiness.test.ts",
    "bless-corpus": "node --experimental-strip-types scripts/bless_corpus.mjs",
    "emit-schema-sql": "node --experimental-strip-types scripts/emit_schema_sql.mjs",
    "check-schema-sql": "node --experimental-strip-types scripts/emit_schema_sql.mjs --check",
    "emit-screenplay-tables": "node --experimental-strip-types scripts/emit_screenplay_tables.mjs",
    "check-screenplay-tables": "node --experimental-strip-types scripts/emit_screenplay_tables.mjs --check",
    "scf-check": "npm run build --silent && node scripts/scf_check.mjs",
    "bless-negative": "node --experimental-strip-types scripts/build_negative.mjs",
    "check-negative": "node --experimental-strip-types scripts/build_negative.mjs --check",
    "emit-finding-catalog": "node --experimental-strip-types scripts/emit_finding_catalog.mjs",
    "check-finding-catalog": "node --experimental-strip-types scripts/emit_finding_catalog.mjs --check",
    "bless-queries": "vitest run test/canonicalQueries.test.ts --mode bless",
    "emit-normative-data": "node --experimental-strip-types scripts/emit_normative_data.mjs",
    "check-normative-data": "node --experimental-strip-types scripts/emit_normative_data.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "bin": {
    "scf-check": "./scripts/scf_check.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "registry/registry.json",
    "scripts/scf_check.mjs",
    "README.md",
    "LICENSE",
    "NOTICE"
  ]
}
