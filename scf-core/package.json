{
  "name": "@minimalhumans/scf-core",
  "version": "0.1.0",
  "description": "SCF (Story Context Framework) core: registry types, database layer, and resolution/readiness semantics. UI-free. Structured publishable, unpublished until the format settles (design decision 6, 2026-07-15).",
  "private": true,
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./src/index.ts",
    "./node": "./src/node.ts",
    "./registry.json": "./registry/registry.json"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "conformance": "vitest run test/conformance.canonical.test.ts test/conformance.readiness.test.ts",
    "bless-corpus": "node --experimental-strip-types scripts/bless_corpus.mjs",
    "emit-schema-sql": "node --experimental-strip-types scripts/emit_schema_sql.mjs",
    "check-schema-sql": "node --experimental-strip-types scripts/emit_schema_sql.mjs --check"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "ajv": "^8.20.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
