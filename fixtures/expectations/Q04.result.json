    "cast": [
      {
        "uuid": "1afb7bf0-8cee-4e2f-9e8e-015f9b2aaf64",
        "fields": {
          "age": "61",
          "arc_description": "From a woman who answers questions with tasks to a woman who says the thing and lets it cost her.",
          "archetype": "the keeper of the house",
          "backstory": "Came west at nineteen. Buried a husband at forty-two and a daughter at fifty-four. Has not left the valley since.",
          "casting_status": "tbd",
          "core_belief": "Work is what love looks like when you can't speak.",
          "external_goal": "Get the homestead through the winter.",
          "flaw": "Mistakes silence for mercy — to others and to herself.",
          "gender": "female",
          "greatest_fear": "That saying it aloud makes it true forever.",
          "internal_goal": "To stop blaming her son without having to forgive him.",
          "lifecycle_status": "active",
          "motivation": "To keep the place standing, and to not have to say aloud what she believes about the day Ada died.",
          "name": "Eleanor Cade",
          "occupation": "Homesteader; midwife to the valley",
          "pronouns": "she/her",
          "role": "protagonist",
          "skills_abilities": "Midwifery, horse handling, reading weather",
          "summary": "Sixty-one, widowed, running the Cade homestead alone since her daughter drowned. Competence is how she holds grief at arm's length."
        }
      },
      {
        "uuid": "145417ca-e8e5-4946-aba0-e83575dad182",
        "fields": {
          "age": "34",
          "arc_description": "From a man performing ease to a man who says the true sentence and survives the silence after it.",
          "archetype": "the returning prodigal",
          "backstory": "Was at the creek the day Ada drowned and has never told anyone. Left within the month; sent money, never letters.",
          "casting_status": "tbd",
          "core_belief": "A debt can be worked off if you work hard enough.",
          "external_goal": "Winter over at the homestead and mend what he can.",
          "flaw": "Confesses only when cornered, then calls it honesty.",
          "gender": "male",
          "greatest_fear": "That his mother already knows.",
          "internal_goal": "Absolution he cannot ask for directly.",
          "lifecycle_status": "active",
          "motivation": "To be told he is not what he believes he is.",
          "name": "Marcus Cade",
          "occupation": "Railroad surveyor",
          "pronouns": "he/him",
          "role": "deuteragonist",
          "summary": "Thirty-four, back after seven years without warning. Carries his sister's locket and the reason he left."
        }
