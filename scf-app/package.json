{
  "name": "@minimalhumans/scf-app",
  "version": "0.1.0",
  "description": "The SCF reference editor. Local-first, Chromium-first; files are served by one local host process.",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:sidecar": "node tools/buildSidecar.mjs",
    "tauri": "tauri",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "bless-queries": "vitest run test/queryExpectations.test.ts --mode bless"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.4",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.6",
    "@tauri-apps/api": "^2.12.4",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^4.3.0",
    "esbuild": "^0.21.5",
    "jsdom": "^29.1.1",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.5.0",
    "vite": "^5.4.0",
    "vitest": "^4.1.10",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "allowScripts": {
    "esbuild": true
  }
}
