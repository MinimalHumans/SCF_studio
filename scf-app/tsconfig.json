{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "vite/client",
      "node"
    ],
    "paths": {
      "@scf-core/*": [
        "../scf-core/src/*"
      ],
      "@registry/*": [
        "../scf-core/registry/*"
      ],
      "@scf-host/*": [
        "../scf-host/src/*"
      ],
      "@scf-mcp/*": [
        "../scf-mcp/src/*"
      ],
      "@minimalhumans/scf-host": [
        "../scf-host/src/index.ts"
      ],
      "@minimalhumans/scf-host/client": [
        "../scf-host/src/client.ts"
      ],
      "@minimalhumans/scf-core/node": [
        "../scf-core/src/node.ts"
      ],
      "@minimalhumans/scf-core": [
        "../scf-core/src/index.ts"
      ]
    }
  },
  "include": [
    "src"
  ]
}